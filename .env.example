# Local showcase only: fictional transactions and a simulated bank.
# Copy to .env; do not commit .env or real credentials.
BANK_PORT=8002
API_PORT=8001
FRONTEND_PORT=3000

# Shared internal simulator key; this default is public and local-only.
FRAUDLENS_BANK_KEY=fraudlens-local-simulator
FRAUDLENS_BANK_DB=var/bank.sqlite3
FRAUDLENS_OPS_DB=var/operations.sqlite3

# The launcher sets these values to the selected ports automatically:
# FRAUDLENS_BANK_URL=http://127.0.0.1:8002
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8001
# FRAUDLENS_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# FRAUDLENS_LEGACY_API=0
# FRAUDLENS_SEED_DEMO=1
# FRAUDLENS_MODE=demo

# JWT signing secret is generated and persisted locally when unset.
# FRAUDLENS_JWT_SECRET=
